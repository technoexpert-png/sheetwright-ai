# Copy to .env only if you need to override a default. `docker compose up`
# works with none of this set.
DATABASE_URL=postgresql+psycopg://sheetwright:sheetwright@localhost:5432/sheetwright
SECRET_KEY=change-me-in-production

# mock (default, no key needed) | anthropic
LLM_PROVIDER=mock

# Copy to .env only if you need to override a default. `docker compose up`
# works with none of this set.
DATABASE_URL=postgresql+psycopg://sheetwright:sheetwright@localhost:5432/sheetwright
SECRET_KEY=change-me-in-production

# Public hostname. Set only in production: www.<this> gets 301'd to <this>.
# Leave unset locally, or every request to www would bounce to the live site.
# CANONICAL_HOST=sheetwrightai.com

# mock (default, no key needed) | anthropic
LLM_PROVIDER=mock
# ANTHROPIC_API_KEY=sk-ant-...
